{
  "name": "enterract",
  "version": "0.1.0",
  "description": "React component library for ERP applications: forms, lookups, Excel-style data grids, workflow and approval controls.",
  "license": "Apache-2.0",
  "author": "JoxNeis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoxNeis/enterract.git"
  },
  "homepage": "https://github.com/JoxNeis/enterract#readme",
  "bugs": {
    "url": "https://github.com/JoxNeis/enterract/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "components",
    "erp",
    "data-grid",
    "forms",
    "design-system",
    "ui"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node scripts/vitest.mjs",
    "test:run": "node scripts/vitest.mjs run",
    "test:ui": "node scripts/vitest.mjs --ui",
    "coverage": "node scripts/vitest.mjs run --coverage",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm audit --omit=dev --audit-level=high",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/ui": "^5.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.9",
    "glob": "^14.0.6",
    "globals": "^17.13.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^5.1.2"
  }
}
